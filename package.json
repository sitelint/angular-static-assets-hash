{
  "name": "@sitelintcode/angular-static-assets-hash",
  "description": "Create a list of static assets and a hash for each file.",
  "author": "Cezary Tomczyk <cezary.tomczyk@gmail.com> (https://www.sitelint.com/)",
  "version": "0.0.29",
  "license": "MOZILLA PUBLIC LICENSE, VERSION 2.0",
  "node": ">=22",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "bin": {
    "createAngularStaticHashes": "dist/cli.js"
  },
  "scripts": {
    "build": "shx rm -rf ./dist && shx mkdir -p ./dist/cjs && echo '{\"type\":\"commonjs\"}' > ./dist/cjs/package.json && tsc && tsc -p tsconfig.cjs.json",
    "scripts:lint": "eslint ./src --ext .js,.ts --fix",
    "lint": "npm run markdown:lint && npm run scripts:lint",
    "markdown:lint": "markdownlint \"**/*.md\" --config=.markdownlint.json --ignore-path=.markdownlintignore",
    "release": "release-it",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "publishConfig": {
    "access": "public"
  },
  "npm": {
    "publish": true
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sitelint/angular-static-assets-hash.git"
  },
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@types/node": "26.0.0",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "eslint": "9.39.4",
    "eslint-cli": "1.1.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-markdown": "5.1.0",
    "eslint-plugin-security": "4.0.1",
    "husky": "9.1.7",
    "markdownlint-cli": "0.49.0",
    "release-it": "20.2.0",
    "shx": "0.4.0",
    "standard-version": "9.5.0",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1"
  },
  "dependencies": {
    "@ungap/global-this": "0.4.4",
    "glob-all": "3.3.1"
  },
  "keywords": [
    "angular",
    "static",
    "assets",
    "cache",
    "busting"
  ],
  "bugs": {
    "url": "https://github.com/sitelint/angular-static-assets-hash/issues"
  },
  "homepage": "https://github.com/sitelint/angular-static-assets-hash#readme"
}

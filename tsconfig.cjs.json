{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "mapRoot": "./dist/cjs",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist/cjs"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts"
  ]
}
